{
  "name": "@careflow/backend",
  "version": "1.0.0",
  "description": "Careflow appointment booking backend - hexagonal Node.js/Fastify service",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "dev:outbox": "tsx watch --clear-screen=false src/workers/outbox-publisher/main.ts",
    "dev:notifications": "tsx watch --clear-screen=false src/workers/notification-consumer/main.ts",
    "dev:sweeper": "tsx watch --clear-screen=false src/workers/hold-sweeper/main.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:outbox": "node dist/workers/outbox-publisher/main.js",
    "start:notifications": "node dist/workers/notification-consumer/main.js",
    "start:sweeper": "node dist/workers/hold-sweeper/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md,yml,yaml}\"",
    "db:migrate": "tsx src/shared/database/migrate.ts",
    "db:seed": "tsx src/shared/database/seed.ts",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:concurrency": "vitest run --project concurrency",
    "test:e2e": "vitest run --project e2e",
    "test:all": "vitest run",
    "test:watch": "vitest watch --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "test:api": "npx --yes newman@6 run docs/postman/Careflow.postman_collection.json -e docs/postman/Careflow.local.postman_environment.json --reporters cli --reporter-cli-no-banner",
    "smoke": "./scripts/smoke.sh"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "3.1110.0",
    "@aws-sdk/client-sqs": "3.1110.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/sensible": "6.0.5",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.1",
    "@fastify/under-pressure": "9.1.0",
    "argon2": "0.45.1",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.0",
    "fastify-plugin": "5.1.0",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "6.0.0",
    "jose": "6.2.8",
    "luxon": "3.7.2",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testcontainers/postgresql": "12.1.0",
    "@testcontainers/redis": "12.1.0",
    "@types/luxon": "3.7.4",
    "@types/node": "22.20.1",
    "@types/pg": "8.21.0",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "0.31.10",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "pino-pretty": "13.1.3",
    "prettier": "3.9.6",
    "testcontainers": "12.1.0",
    "tsc-alias": "1.9.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
