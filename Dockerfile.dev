# syntax=docker/dockerfile:1.7

# Local development image: source is bind-mounted and `tsx watch` reloads on change.
# Deliberately separate from the production Dockerfile so that dev conveniences can
# never leak into a shipped artifact.
FROM node:22.22-alpine
WORKDIR /app

RUN apk add --no-cache python3 make g++ curl dumb-init

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .

ENV NODE_ENV=development
EXPOSE 3000

ENTRYPOINT ["dumb-init", "--"]
CMD ["npm", "run", "dev"]
