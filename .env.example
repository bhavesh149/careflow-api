# ---------------------------------------------------------------------------
# Careflow backend configuration.
#
# `.env.example` is the committed contract: every variable the process reads, with a safe
# local default. Copy it to `.env` (already done for this checkout) and edit `.env` only.
# `.env` is gitignored. In AWS, Secrets Manager injects the same names — never a file.
#
# Hostnames in this file are for running Node on your laptop against published ports
# (`localhost`). Docker Compose loads this file and then overrides Postgres/Redis/SQS
# URLs to the Compose DNS names (`postgres`, `redis`, `localstack`).
#
# AWS: there is no .env on ECS. See docs/05-aws-first-deploy.md for where each value is
# generated and which store it belongs in (GitHub secret vs Secrets Manager vs CDK context).
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=debug
PORT=3000
HOST=0.0.0.0
SERVICE_NAME=careflow-api
INSTANCE_ID=local

# Postgres. The API uses careflow_app (DML only). Migrations use careflow_owner (DDL).
DATABASE_URL=postgresql://careflow_app:careflow_local_pw@localhost:5432/careflow
MIGRATION_DATABASE_URL=postgresql://careflow_owner:careflow_owner_pw@localhost:5432/careflow
DB_SSL=false
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_STATEMENT_TIMEOUT_MS=10000

# Redis: rate limits + schedule cache only. Booking correctness never depends on it.
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=true

# Auth. Generate a real secret for anything that is not a laptop:
#   openssl rand -base64 64
JWT_SECRET=local_dev_only_secret_change_me_00000000000000000000000000000000
JWT_ISSUER=careflow
JWT_AUDIENCE=careflow-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600
COOKIE_SECURE=false
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax

# Comma-separated exact origins. No wildcards in production.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# Booking domain policy.
APP_TIMEZONE=Asia/Kolkata
SLOT_GRANULARITY_MINUTES=60
HOLD_TTL_SECONDS=60
MAX_ACTIVE_HOLDS_PER_PATIENT=3
AVAILABILITY_MAX_RANGE_DAYS=60
RECURRENCE_MAX_OCCURRENCES=26
RECURRENCE_MAX_HORIZON_DAYS=183
STATUS_UPDATE_GRACE_HOURS=24
IDEMPOTENCY_TTL_HOURS=24

# Rate limits (requests per window). Login is stricter in production (5 / 5 min).
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=300
RATE_LIMIT_MUTATION_MAX=30
RATE_LIMIT_MUTATION_WINDOW_SECONDS=60

# Async messaging. LocalStack locally, real SQS in AWS.
QUEUE_DRIVER=sqs
AWS_REGION=ap-south-1
SQS_QUEUE_URL=http://localhost:4566/000000000000/careflow-events
SQS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Workers
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=8
HOLD_SWEEPER_INTERVAL_MS=5000
WORKER_HEALTH_PORT=3100

# Swagger UI. Disable in production unless the API is intentionally public.
SWAGGER_ENABLED=true
