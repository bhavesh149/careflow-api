  "dependencies": {
    "aws-cdk-lib": "2.265.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "aws-cdk": "2.1136.0",
    "tsx": "4.20.5",
    "typescript": "5.9.3"
  }
}
